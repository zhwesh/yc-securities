# 前端工程忽略规则

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
coverage/

# 本地 npm 缓存
.npm-cache/

# nginx 部署包：含 nginx.exe 二进制与构建产物，不入库
deploy/

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境与覆盖配置
*.local

# 含接口文档访问令牌，不入库
AGENTS.md

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
